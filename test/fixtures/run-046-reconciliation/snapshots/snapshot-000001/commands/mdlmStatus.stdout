                    ],
                    "created_by": {
                      "scenario": "revise-foundation-after-review@5",
                      "prompt_ref": "prompts/revise-foundation-after-review.md@5",
                      "process_ref": "mdlm-bootstrap@0.74.0#sha256:e77a022a2cb2d6e7d78bccba753b5d117d4384dce5621d31a397a861edf8878f",
