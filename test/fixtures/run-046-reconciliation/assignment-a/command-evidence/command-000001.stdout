      {
        "type": "REV",
        "envelope": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://mdlm.dev/kernel/process-interface/v1/datum-envelope.schema.json",
          "title": "Kernel-owned MDLM datum envelope",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision",
            "revision_id",
            "type",
            "payload",
            "links",
            "created_by",
            "body"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Z]{3,8}-[0-9A-HJKMNP-TV-Z]{10,12}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "revision_id": {
              "type": "string",
              "pattern": "^[A-Z]{3,8}-[0-9A-HJKMNP-TV-Z]{10,12}-r[0-9]{5}$"
            },
            "type": {
              "type": "string",
              "pattern": "^[A-Z]{3,8}$"
            },
            "payload": {
              "type": "object"
            },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "target"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "uniqueItems": true
            },
            "created_by": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scenario",
                "prompt_ref",
                "process_ref",
                "loaded_skill_refs",
                "policy_refs"
              ],
              "properties": {
                "scenario": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"
                },
                "prompt_ref": {
                  "type": "string",
                  "pattern": "^prompts/.+\\.md@[1-9][0-9]*$"
                },
                "process_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "loaded_skill_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^skills/.+\\.md@[1-9][0-9]*$"
                  },
                  "uniqueItems": true
                },
                "policy_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"
                  },
                  "uniqueItems": true
                }
              }
            },
            "body": {
              "type": "string"
            }
          },
          "x-mdlm-kernel-invariants": [
            "id prefix equals type",
            "revision_id equals id plus zero-padded revision",
            "frozen revisions are immutable",
            "at most one local editable revision exists per stable id"
          ]
        },
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "rubric_ref",
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "review_kind": {
              "enum": [
                "contextual",
                "simplification-product-definition",
                "simplification-architecture-interfaces",
                "cross-group",
                "gate"
              ]
            },
            "decomposition_plan_revision": {
              "type": "string",
              "pattern": "^DWP-[0-9A-HJKMNP-TV-Z]{10,12}-r[0-9]{5}$"
            },
            "rubric_ref": {
              "type": "string",
              "pattern": "^policies/rubrics/.+\\.md@[1-9][0-9]*$"
            },
            "findings": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "target",
                  "relationship",
                  "severity",
                  "summary"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^F-[0-9]{3,}$"
                  },
                  "target": {
                    "type": "string",
                    "pattern": "^[A-Z]{3,8}-[0-9A-HJKMNP-TV-Z]{10,12}-r[0-9]{5}$"
                  },
                  "relationship": {
                    "enum": [
                      "primary",
                      "collateral"
                    ]
                  },
                  "severity": {
                    "enum": [
                      "blocking",
                      "needs-triage",
                      "advisory"
                    ]
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "criterion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  },
                  "material_consequence": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "severity": {
                          "const": "blocking"
                        }
                      },
                      "required": [
                        "severity"
                      ]
                    },
                    "then": {
                      "required": [
                        "criterion",
                        "evidence",
                        "material_consequence"
                      ]
                    }
                  }
                ]
              }
            },
            "simplification": {
              "description": "One exact correction target with every blocking Phase 0 or planning-DWP simplification finding that applies to it.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "findings"
              ],
              "properties": {
                "target": {
                  "type": "string",
                  "pattern": "^[A-Z]{3,8}-[0-9A-HJKMNP-TV-Z]{10,12}-r[0-9]{5}$"
                },
                "findings": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "severity",
                      "summary",
                      "criterion",
                      "evidence",
                      "material_consequence"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^F-[0-9]{3,}$"
                      },
                      "severity": {
                        "const": "blocking"
                      },
                      "summary": {
                        "type": "string",
                        "minLength": 1
                      },
                      "criterion": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 1
                      },
                      "material_consequence": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            },
            "definition_simplification": {
              "description": "Exact Phase 2 subject or declared definition-consistency set selected by blocking simplification findings.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "primary_target",
                "correction_set",
                "primary_findings"
              ],
              "properties": {
                "primary_target": {
                  "type": "string",
                  "pattern": "^(SYS|ASP|ICSP|DWP)-[0-9A-HJKMNP-TV-Z]{10,12}-r[0-9]{5}$"
                },
                "correction_set": {
                  "enum": [
                    "subject",
                    "definition-consistency"
                  ]
                },
                "primary_findings": {
                  "description": "Every blocking Finding owned by the declared exact primary target.",
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "severity",
                      "summary",
                      "criterion",
                      "evidence",
                      "material_consequence"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^F-[0-9]{3,}$"
                      },
                      "severity": {
                        "const": "blocking"
                      },
                      "summary": {
                        "type": "string",
                        "minLength": 1
                      },
                      "criterion": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 1
                      },
                      "material_consequence": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "collateral_findings": {
                  "description": "Findings owned collectively by the exact canonical blockers of a declared definition-consistency set.",
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "severity",
                      "summary"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^F-[0-9]{3,}$"
                      },
                      "severity": {
                        "enum": [
                          "blocking",
                          "needs-triage",
                          "advisory"
                        ]
                      },
                      "summary": {
                        "type": "string",
                        "minLength": 1
                      },
                      "criterion": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 1
                      },
                      "material_consequence": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "severity": {
                              "const": "blocking"
                            }
                          },
                          "required": [
                            "severity"
                          ]
                        },
                        "then": {
                          "required": [
                            "criterion",
                            "evidence",
                            "material_consequence"
                          ]
                        }
                      }
                    ]
                  }
                },
                "scope_reduction": {
                  "description": "Rationale for exact SYS outputs named by this Review's removes links.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rationale"
                  ],
                  "properties": {
                    "rationale": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "correction_set": {
                        "const": "subject"
                      }
                    },
                    "required": [
                      "correction_set"
                    ]
                  },
                  "then": {
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "collateral_findings"
                          ]
                        },
                        {
                          "required": [
                            "scope_reduction"
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "correction_authority": {
              "description": "Classifies whether a failed Review needs stakeholder judgment or can be corrected from exact package evidence.",
              "enum": [
                "stakeholder",
                "package-evidence"
              ]
            },
            "outcome": {
              "enum": [
                "open",
                "pass",
                "fail",
                "cancelled"
              ]
            },
            "cancellation_reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "outcome": {
                        "const": "fail"
                      }
                    },
                    "required": [
                      "outcome"
                    ]
                  },
                  "then": {
                    "required": [
                      "correction_authority"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "correction_authority"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "findings": {
                        "contains": {
                          "type": "object",
                          "required": [
                            "relationship",
                            "severity"
                          ],
                          "properties": {
                            "relationship": {
                              "const": "primary"
                            },
                            "severity": {
                              "const": "blocking"
                            }
                          }
                        }
                      }
                    },
                    "required": [
                      "findings"
                    ]
                  },
                  "then": {
                    "properties": {
                      "outcome": {
                        "const": "fail"
                      }
                    },
                    "required": [
                      "outcome"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "review_kind": {
                        "const": "simplification-product-definition"
                      }
                    },
                    "required": [
                      "review_kind"
                    ]
                  },
                  "then": {
                    "not": {
                      "required": [
                        "findings"
                      ]
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "outcome": {
                              "const": "fail"
                            }
                          },
                          "required": [
                            "outcome"
                          ]
                        },
                        "then": {
                          "required": [
                            "simplification"
                          ]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "outcome": {
                              "const": "pass"
                            }
                          },
                          "required": [
                            "outcome"
                          ]
                        },
                        "then": {
                          "not": {
                            "required": [
                              "simplification"
                            ]
                          }
                        }
                      }
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "simplification"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "review_kind": {
                        "const": "simplification-architecture-interfaces"
                      }
                    },
                    "required": [
                      "review_kind"
                    ]
                  },
                  "then": {
                    "allOf": [
                      {
                        "not": {
                          "required": [
                            "findings"
                          ]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "outcome": {
                              "const": "fail"
                            }
                          },
                          "required": [
                            "outcome"
                          ]
                        },
                        "then": {
                          "required": [
                            "definition_simplification"
                          ]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "outcome": {
                              "enum": [
                                "pass",
                                "cancelled"
                              ]
                            }
                          },
                          "required": [
                            "outcome"
                          ]
                        },
                        "then": {
                          "not": {
                            "required": [
                              "definition_simplification"
                            ]
                          }
                        }
                      }
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "definition_simplification"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "review_kind": {
                        "enum": [
                          "simplification-product-definition",
                          "simplification-architecture-interfaces"
                        ]
                      }
                    },
                    "required": [
                      "review_kind"
                    ]
                  },
                  "else": {
                    "required": [
                      "findings"
                    ]
                  }
                }
              ]
            }
          ]
        },
