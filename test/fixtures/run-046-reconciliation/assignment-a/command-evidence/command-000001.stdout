  "obligation": {
    "instance": "foundation-review-escalation-required@2:PSP-6WE7NE0F46-r00004:mdlm-bootstrap@0.74.0#sha256:e77a022a2cb2d6e7d78bccba753b5d117d4384dce5621d31a397a861edf8878f",
