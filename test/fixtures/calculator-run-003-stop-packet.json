        "type": "BSL",
        "envelope": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://mdlm.dev/kernel/process-interface/v1/datum-envelope.schema.json",
          "title": "Kernel-owned MDLM datum envelope",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision",
            "revision_id",
            "type",
            "payload",
            "links",
            "created_by",
            "body"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Z]{3,8}-[0-9A-HJKMNP-TV-Z]{10,12}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "revision_id": {
              "type": "string",
              "pattern": "^[A-Z]{3,8}-[0-9A-HJKMNP-TV-Z]{10,12}-r[0-9]{5}$"
            },
            "type": {
              "type": "string",
              "pattern": "^[A-Z]{3,8}$"
            },
            "payload": {
              "type": "object"
            },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "target"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "uniqueItems": true
            },
            "created_by": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scenario",
                "prompt_ref",
                "process_ref",
                "loaded_skill_refs",
                "policy_refs"
              ],
              "properties": {
                "scenario": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"
                },
                "prompt_ref": {
                  "type": "string",
                  "pattern": "^prompts/.+\\.md@[1-9][0-9]*$"
                },
                "process_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "loaded_skill_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^skills/.+\\.md@[1-9][0-9]*$"
                  },
                  "uniqueItems": true
                },
                "policy_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"
                  },
                  "uniqueItems": true
                }
              }
            },
            "body": {
              "type": "string"
            }
          },
          "x-mdlm-kernel-invariants": [
            "id prefix equals type",
            "revision_id equals id plus zero-padded revision",
            "frozen revisions are immutable",
            "at most one local editable revision exists per stable id"
          ]
        },
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definition_members",
            "evidence",
            "group",
            "kind",
            "role",
            "scope",
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "source-boundary",
                "review-context",
                "pilot-assessment-context",
                "intent-group-candidate",
                "intent-level-candidate",
                "intent-approved",
                "group-candidate",
                "level-candidate",
                "group-accepted",
                "level-accepted"
              ]
            },
            "role": {
              "enum": [
                "source-boundary",
                "review-context",
                "candidate",
                "accepted"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "group": {
              "type": "string",
              "minLength": 1
            },
            "definition_members": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z]{3,8}-[0-9A-HJKMNP-TV-Z]{10,12}-r[0-9]{5}$"
              }
            },
            "evidence": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z]{3,8}-[0-9A-HJKMNP-TV-Z]{10,12}-r[0-9]{5}$"
              }
            },
            "snapshot": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "frozen_at",
                "member_hashes",
                "resolved_links",
                "process_provenance"
              ],
              "properties": {
                "frozen_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "member_hashes": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                },
                "resolved_links": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "process_provenance": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "process_ref",
                    "manifest_hash",
                    "asset_refs"
                  ],
                  "properties": {
                    "process_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "manifest_hash": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "asset_refs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    }
                  }
                }
              }
            }
          }
        },
        "outgoingLinks": [
          {
            "id": "composes",
            "description": "Exact group baseline revisions composed by this level baseline.",
            "targets": [
              {
                "kind": "datum",
                "types": [
                  "BSL"
                ],
                "identity": "revision"
              }
            ],
            "cardinality": {
              "minimum": 0,
              "maximum": "many"
            },
            "freeze_resolution": "already-exact",
            "inverse_label": "composed-by"
          },
          {
            "id": "promotes",
            "description": "Exact candidate baseline promoted by this approved or accepted baseline.",
            "targets": [
              {
                "kind": "datum",
                "types": [
                  "BSL"
                ],
                "identity": "revision"
              }
            ],
            "cardinality": {
              "minimum": 0,
              "maximum": 1
            },
            "freeze_resolution": "already-exact",
            "inverse_label": "promoted-by"
          },
          {
            "id": "supersedes",
            "description": "Older baseline for the same role and scope explicitly replaced by this baseline.",
            "targets": [
              {
                "kind": "datum",
                "types": [
                  "BSL"
                ],
                "identity": "revision"
              }
            ],
            "cardinality": {
              "minimum": 0,
              "maximum": 1
            },
            "freeze_resolution": "already-exact",
            "inverse_label": "superseded-by"
          },
          {
            "id": "corrects-review",
            "description": "Exact failed Reviews whose blocking findings this replacement baseline Revision addresses.",
            "targets": [
              {
                "kind": "datum",
                "types": [
                  "REV"
                ],
                "identity": "revision"
              }
            ],
            "cardinality": {
              "minimum": 0,
              "maximum": "many"
            },
            "freeze_resolution": "already-exact",
            "inverse_label": "corrected-by-baseline"
          },
          {
            "id": "corrects-gate-rejection",
            "description": "Exact reviewed gate rejection Decisions addressed by this replacement candidate.",
            "targets": [
              {
                "kind": "datum",
                "types": [
                  "DEC"
                ],
                "identity": "revision"
              }
            ],
            "cardinality": {
              "minimum": 0,
              "maximum": "many"
            },
            "freeze_resolution": "already-exact",
            "inverse_label": "corrected-by-candidate"
          },
          {
            "id": "changed-under",
            "description": "Exact approved Change Request requiring this replacement context or baseline.",
            "targets": [
              {
                "kind": "datum",
                "types": [
                  "CHG"
                ],
                "identity": "revision"
              }
            ],
            "cardinality": {
              "minimum": 0,
              "maximum": 1
            },
            "freeze_resolution": "already-exact",
            "inverse_label": "changed-baseline"
          }
        ]
      }
    ]
  },
  "policies": [
    {
      "role": "review",
      "reference": "review-applicability@1",
      "definition": {
        "id": "review-applicability",
        "version": 1
      }
    },
    {
      "role": "waiver",
      "reference": "waiver-applicability@1",
      "definition": {
        "id": "waiver-applicability",
        "version": 1
      },
      "result": {
        "permitted": false,
        "approval_required": true,
        "applicable": false,
        "scope": null
      }
    }
  ],
  "participation": [],
  "authority": {
    "evidence": null,
    "requirements": [],
    "standingDelegation": null
  },
  "prohibitions": [
    "borrowed Review Context provenance",
    "mutable latest aliases",
    "unrelated revisions"
  ],
  "outputs": [
    {
      "name": "boundary",
      "types": [
        "BSL"
      ],
      "cardinality": "one",
      "requiredLinks": []
    }
  ],
  "outputLinks": [
    {
      "output": "boundary",
      "requiredLinks": []
    }
  ],
  "completion": {
    "expression": "execution.integrity.contract_valid == true && boundary.storage.frozen == true && boundary.payload.kind == \"source-boundary\" && boundary.payload.role == \"source-boundary\" && boundary.payload.scope == source.identity.revision_id && boundary.payload.group == \"SAME-LINEAGE\" && boundary.payload.definition_members == [source.identity.revision_id] && none(\"source-boundary-evidence@1\", {boundary: boundary})",
    "status": "pending-output",
    "genericChecks": [
      "declared-output-cardinality",
      "no-undeclared-outputs",
      "output-schema-validity",
      "source-owned-required-links"
    ]
  },
  "responseSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://mdlm.dev/contracts/mdlm-assignment-response@1",
    "title": "MDLM Assignment Response",
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract",
          "assignment",
          "kind",
          "proposal"
        ],
        "properties": {
          "contract": {
            "const": "mdlm-assignment-response@1"
          },
          "assignment": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "proposal"
          },
          "proposal": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outputs",
              "completionEvidence",
              "loadedSkillRefs",
              "authoritySupplies",
              "standingDelegations"
            ],
            "properties": {
              "outputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "localId",
                    "name",
                    "invocation",
                    "lifecycleDatum"
                  ],
                  "properties": {
                    "localId": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                      "description": "Proposal-local identity used by $proposal.<localId>.id and $proposal.<localId>.revision_id references"
                    },
                    "name": {
                      "type": "string"
                    },
                    "invocation": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "lifecycleDatum": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "payload",
                        "links",
                        "body"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "Existing Stable Datum identity for a same-lineage replacement; omit for a new Stable Datum"
                        },
                        "type": {
                          "type": "string",
                          "pattern": "^[A-Z]{3,8}$"
                        },
                        "payload": {
                          "type": "object"
                        },
                        "links": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "type",
                              "target"
                            ],
                            "properties": {
                              "type": {
                                "type": "string"
                              },
                              "target": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "body": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "completionEvidence": {},
              "loadedSkillRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "authoritySupplies": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "standingDelegations": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract",
          "assignment",
          "kind",
          "unable"
        ],
        "properties": {
          "contract": {
            "const": "mdlm-assignment-response@1"
          },
          "assignment": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "unable"
          },
          "unable": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "diagnostics"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "stale-scope",
                  "insufficient-declared-inputs",
                  "prohibited-input-conflict",
                  "ambiguity",
                  "execution-failure"
                ]
              },
              "diagnostics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "diagnostics": []
}
