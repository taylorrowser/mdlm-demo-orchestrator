                    "revision_id": "DEC-EBHPCWVRSG-r00001",
                    "type": "DEC",
                    "payload": {
                      "title": "Command-line calculator product intent",
                      "rationale": "The attended stakeholder explicitly selected this product behavior and its command-line, operand, operator, output, rounding, and error-handling boundaries.",
                      "kind": "scope",
                      "decision": "Build a command-line calculator. Invoke it as `calculator <left> <operator> <right>`. Support only the operators `+`, `-`, `*`, and `/`. Accept operands matching exactly `[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)`. Emit canonical successful output. For nonterminating results, round exactly at the 12th fractional digit using half-away-from-zero and then trim. For invalid input, emit no stdout, emit exactly `invalid input\\n` on stderr, and exit 2. For division by zero, emit no stdout, emit exactly `division by zero\\n` on stderr, and exit 2.",
                      "alternatives": [],
                      "effective_scope": "QST-21219K6RVZ-r00002"
                    },
