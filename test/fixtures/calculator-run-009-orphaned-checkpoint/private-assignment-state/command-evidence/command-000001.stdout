                  },
                  "relationship": {
                    "enum": [
                      "primary",
                      "collateral"
                    ]
                  },
                  "severity": {
                    "enum": [
                      "blocking",
                      "needs-triage",
                      "advisory"
                    ]
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "criterion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  },
                  "material_consequence": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "severity": {
                          "const": "blocking"
                        }
                      },
                      "required": [
                        "severity"
                      ]
                    },
                    "then": {
                      "required": [
                        "criterion",
                        "evidence",
                        "material_consequence"
                      ]
                    }
                  }
                ]
              }
            },
            "simplification": {
              "description": "One exact correction target with every blocking Phase 0 or planning-DWP simplification finding that applies to it.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "findings"
              ],
              "properties": {
