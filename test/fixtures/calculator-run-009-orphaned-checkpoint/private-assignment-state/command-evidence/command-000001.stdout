                      "change_disposition"
                    ]
                  }
                },
                {
                  "if": {
                    "required": [
                      "change_disposition"
                    ]
                  },
                  "then": {
                    "properties": {
                      "kind": {
                        "const": "change-approval"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "change_disposition": {
                        "const": "defer"
                      }
                    },
                    "required": [
                      "change_disposition"
                    ]
                  },
                  "then": {
                    "required": [
                      "change_reactivation_condition"
                    ]
                  }
                },
                {
                  "if": {
                    "required": [
                      "change_reactivation_condition"
                    ]
                  },
                  "then": {
                    "properties": {
                      "kind": {
