      {
        "type": "QST",
        "envelope": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://mdlm.dev/kernel/process-interface/v1/datum-envelope.schema.json",
          "title": "Kernel-owned MDLM datum envelope",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision",
            "revision_id",
            "type",
            "payload",
            "links",
            "created_by",
            "body"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Z]{3,8}-[0-9A-HJKMNP-TV-Z]{10,12}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "revision_id": {
              "type": "string",
              "pattern": "^[A-Z]{3,8}-[0-9A-HJKMNP-TV-Z]{10,12}-r[0-9]{5}$"
            },
            "type": {
              "type": "string",
              "pattern": "^[A-Z]{3,8}$"
            },
            "payload": {
              "type": "object"
            },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "target"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "uniqueItems": true
            },
            "created_by": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scenario",
                "prompt_ref",
                "process_ref",
                "loaded_skill_refs",
                "policy_refs"
              ],
              "properties": {
                "scenario": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"
                },
                "prompt_ref": {
                  "type": "string",
                  "pattern": "^prompts/.+\\.md@[1-9][0-9]*$"
                },
                "process_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "loaded_skill_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^skills/.+\\.md@[1-9][0-9]*$"
                  },
                  "uniqueItems": true
                },
                "policy_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"
                  },
                  "uniqueItems": true
                }
              }
            },
            "body": {
              "type": "string"
            }
          },
          "x-mdlm-kernel-invariants": [
            "id prefix equals type",
            "revision_id equals id plus zero-padded revision",
            "frozen revisions are immutable",
            "at most one local editable revision exists per stable id"
          ]
        },
        "payload": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blocking_impact",
            "kind",
            "question",
            "state",
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "preferential",
                "empirical"
              ]
            },
            "intent_scope": {
              "enum": [
                "product"
              ]
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "attended_answer": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "enum": [
                "open",
                "answered",
                "deferred",
                "cancelled"
              ]
            },
            "blocking_impact": {
              "type": "string",
              "minLength": 1
            },
            "reactivation_condition": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "evidence_available": {
              "type": "boolean"
            },
            "resolution_disposition": {
              "enum": [
                "answer",
                "defer",
                "cancel"
              ]
            },
            "attention_checkpoint": {
              "enum": [
                "phase-0-gate",
                "phase-2-system-gate"
              ]
            },
            "consolidation_group": {
              "enum": [
                "phase-0-stakeholder-questions",
                "phase-2-system-stakeholder-questions"
              ]
            },
            "resolution_evidence": {
              "enum": [
                "prototype"
              ]
            },
            "prototype_evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository_ref",
                "supported_behavior",
                "unsupported_behavior",
                "finding_if_supported",
                "finding_if_not_supported"
              ],
              "properties": {
                "repository_ref": {
                  "type": "string",
                  "pattern": "^git:[0-9a-f]{40}$"
                },
                "supported_behavior": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "unsupported_behavior": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "finding_if_supported": {
                  "type": "string",
                  "minLength": 1
                },
                "finding_if_not_supported": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "allOf": [
            {
              "dependentRequired": {
                "attention_checkpoint": [
                  "consolidation_group"
                ],
                "consolidation_group": [
                  "attention_checkpoint"
                ],
                "resolution_evidence": [
                  "prototype_evidence"
                ],
                "prototype_evidence": [
                  "resolution_evidence"
                ]
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "intent_scope": {
                        "const": "product"
                      },
                      "state": {
                        "const": "answered"
                      }
                    },
                    "required": [
                      "intent_scope",
                      "state"
                    ]
                  },
                  "then": {
                    "required": [
                      "attended_answer"
                    ]
                  }
                },
                {
                  "if": {
                    "required": [
                      "attended_answer"
                    ]
                  },
                  "then": {
                    "properties": {
                      "kind": {
                        "const": "preferential"
                      },
                      "state": {
                        "const": "answered"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "state": {
                        "const": "deferred"
                      }
                    },
                    "required": [
                      "state"
                    ]
                  },
                  "then": {
                    "required": [
                      "reactivation_condition"
                    ]
                  }
                },
                {
                  "if": {
                    "required": [
                      "evidence_available"
                    ]
                  },
                  "then": {
                    "properties": {
                      "kind": {
                        "const": "empirical"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "anyOf": [
                      {
                        "required": [
                          "attention_checkpoint"
                        ]
                      },
                      {
                        "required": [
                          "consolidation_group"
                        ]
                      }
                    ]
                  },
                  "then": {
                    "properties": {
                      "kind": {
                        "const": "preferential"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "resolution_evidence"
                    ]
                  },
                  "then": {
                    "properties": {
                      "kind": {
                        "const": "empirical"
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "outgoingLinks": [
          {
