                }
              }
            },
            "definition_simplification": {
              "description": "Exact Phase 2 subject or declared definition-consistency set selected by blocking simplification findings.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "primary_target",
                "correction_set",
                "primary_findings"
              ],
              "properties": {
                "primary_target": {
                  "type": "string",
                  "pattern": "^(SYS|ASP|ICSP|DWP)-[0-9A-HJKMNP-TV-Z]{10,12}-r[0-9]{5}$"
                },
                "correction_set": {
                  "enum": [
                    "subject",
                    "definition-consistency"
                  ]
                },
                "primary_findings": {
                  "description": "Every blocking Finding owned by the declared exact primary target.",
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "severity",
                      "summary",
                      "criterion",
                      "evidence",
                      "material_consequence"
                    ],
                    "properties": {
