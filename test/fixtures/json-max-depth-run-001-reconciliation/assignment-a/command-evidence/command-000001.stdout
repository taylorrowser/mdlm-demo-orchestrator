        "type": "MAP",
        "envelope": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://mdlm.dev/kernel/process-interface/v1/datum-envelope.schema.json",
          "title": "Kernel-owned MDLM datum envelope",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision",
            "revision_id",
            "type",
            "payload",
            "links",
            "created_by",
