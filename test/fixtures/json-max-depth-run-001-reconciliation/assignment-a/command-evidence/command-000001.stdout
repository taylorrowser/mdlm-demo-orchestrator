            "question",
            "state",
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "preferential",
                "empirical"
              ]
            },
            "intent_scope": {
              "enum": [
                "product"
              ]
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "attended_answer": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "enum": [
                "open",
                "answered",
                "deferred",
                "cancelled"
              ]
            },
            "blocking_impact": {
              "type": "string",
              "minLength": 1
            },
            "reactivation_condition": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "evidence_available": {
              "type": "boolean"
            },
            "resolution_disposition": {
              "enum": [
                "answer",
                "defer",
                "cancel"
              ]
            },
            "attention_checkpoint": {
              "enum": [
                "phase-0-gate",
                "phase-2-system-gate"
              ]
            },
            "consolidation_group": {
              "enum": [
                "phase-0-stakeholder-questions",
                "phase-2-system-stakeholder-questions"
              ]
            },
            "resolution_evidence": {
              "enum": [
                "prototype"
              ]
            },
            "prototype_evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository_ref",
                "supported_behavior",
                "unsupported_behavior",
                "finding_if_supported",
                "finding_if_not_supported"
              ],
              "properties": {
                "repository_ref": {
                  "type": "string",
                  "pattern": "^git:[0-9a-f]{40}$"
                },
                "supported_behavior": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "unsupported_behavior": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "finding_if_supported": {
                  "type": "string",
                  "minLength": 1
                },
                "finding_if_not_supported": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "allOf": [
            {
              "dependentRequired": {
                "attention_checkpoint": [
                  "consolidation_group"
                ],
                "consolidation_group": [
                  "attention_checkpoint"
                ],
                "resolution_evidence": [
                  "prototype_evidence"
                ],
                "prototype_evidence": [
                  "resolution_evidence"
                ]
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "intent_scope": {
                        "const": "product"
                      },
                      "state": {
                        "const": "answered"
                      }
                    },
                    "required": [
                      "intent_scope",
                      "state"
                    ]
                  },
                  "then": {
                    "required": [
                      "attended_answer"
                    ]
                  }
                },
                {
                  "if": {
                    "required": [
                      "attended_answer"
                    ]
                  },
                  "then": {
                    "properties": {
                      "kind": {
                        "const": "preferential"
                      },
                      "state": {
                        "const": "answered"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "state": {
                        "const": "deferred"
                      }
                    },
                    "required": [
                      "state"
                    ]
                  },
                  "then": {
                    "required": [
                      "reactivation_condition"
                    ]
                  }
                },
                {
                  "if": {
                    "required": [
                      "evidence_available"
                    ]
                  },
                  "then": {
                    "properties": {
                      "kind": {
                        "const": "empirical"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "anyOf": [
                      {
                        "required": [
                          "attention_checkpoint"
                        ]
                      },
                      {
                        "required": [
                          "consolidation_group"
                        ]
                      }
                    ]
                  },
                  "then": {
                    "properties": {
                      "kind": {
                        "const": "preferential"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "resolution_evidence"
                    ]
                  },
                  "then": {
                    "properties": {
                      "kind": {
                        "const": "empirical"
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "outgoingLinks": [
          {
            "id": "blocks",
            "description": "Lifecycle concepts whose progress depends on this open question.",
            "targets": [
              {
                "kind": "datum",
                "types": [
                  "PSP",
                  "STK",
                  "SYS",
                  "ASP",
                  "ICSP",
                  "DWP",
                  "VSP",
                  "ENV",
                  "VER",
                  "VAI",
                  "BSL",
                  "QST",
                  "DEC"
                ],
                "identity": "stable"
              }
            ],
            "cardinality": {
              "minimum": 0,
              "maximum": "many"
            },
            "freeze_resolution": "exact-revision",
            "inverse_label": "blocked-by"
          }
        ]
      }
    ]
  },
  "policies": [
    {
      "role": "review",
      "reference": "review-applicability@1",
      "definition": {
        "id": "review-applicability",
        "version": 1
      }
    },
    {
      "role": "waiver",
      "reference": "waiver-applicability@1",
      "definition": {
        "id": "waiver-applicability",
        "version": 1
      },
      "result": {
        "permitted": false,
        "approval_required": true,
        "applicable": false,
        "scope": null
      }
    }
  ],
  "participation": [],
  "authority": {
    "evidence": null,
    "requirements": [],
    "standingDelegation": null
  },
  "prohibitions": [
    "generated indexes as lifecycle truth",
    "unstated stakeholder preferences"
  ],
  "outputs": [
    {
      "name": "map",
      "types": [
        "MAP"
      ],
      "cardinality": "one",
      "requiredLinks": [
        {
          "link": "indexes",
          "target": {
            "output": "product_intent"
          }
        },
        {
          "link": "indexes",
          "target": {
            "output": "questions"
          }
        }
      ]
    },
    {
      "name": "product_intent",
      "types": [
        "QST"
      ],
      "cardinality": "one",
      "requiredLinks": []
    },
    {
      "name": "questions",
      "types": [
        "QST"
      ],
      "cardinality": "zero-or-more",
      "requiredLinks": []
    }
  ],
  "outputLinks": [
    {
      "output": "map",
      "requiredLinks": [
        {
          "link": "indexes",
          "target": {
            "output": "product_intent"
          }
        },
        {
          "link": "indexes",
          "target": {
            "output": "questions"
          }
        }
      ]
    },
    {
      "output": "product_intent",
      "requiredLinks": []
    },
    {
      "output": "questions",
      "requiredLinks": []
    }
  ],
  "completion": {
    "expression": "execution.integrity.contract_valid == true && map.payload.frontier != [] && count(\"product-intent-questions-from-initial-map@1\", {}) == 1 && every(\"product-intent-questions-from-initial-map@1\", {}, question =>\n  question == product_intent)\n&& product_intent.payload.question != \"\" && product_intent.payload.blocking_impact != \"\" && !present(product_intent.payload.attention_checkpoint) && !present(product_intent.payload.consolidation_group) && (\n  !present(product_intent.payload.resolution_disposition)\n  || product_intent.payload.resolution_disposition == \"answer\"\n)",
    "status": "pending-output",
    "genericChecks": [
      "declared-output-cardinality",
      "no-undeclared-outputs",
      "output-schema-validity",
      "source-owned-required-links"
    ]
  },
  "responseSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://mdlm.dev/contracts/mdlm-assignment-response@1",
    "title": "MDLM Assignment Response",
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract",
          "assignment",
          "kind",
          "proposal"
        ],
        "properties": {
          "contract": {
            "const": "mdlm-assignment-response@1"
          },
          "assignment": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "proposal"
          },
          "proposal": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outputs",
              "completionEvidence",
              "loadedSkillRefs",
              "authoritySupplies",
              "standingDelegations"
            ],
            "properties": {
              "outputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "localId",
                    "name",
                    "invocation",
                    "lifecycleDatum"
                  ],
                  "properties": {
                    "localId": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                      "description": "Proposal-local identity used by $proposal.<localId>.id and $proposal.<localId>.revision_id references"
                    },
                    "name": {
                      "type": "string"
                    },
                    "invocation": {
                      "type": "integer",
                      "enum": [
                        0
                      ]
                    },
                    "lifecycleDatum": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "payload",
                        "links",
                        "body"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "Existing Stable Datum identity for a same-lineage replacement; omit for a new Stable Datum"
                        },
                        "type": {
                          "type": "string",
                          "pattern": "^[A-Z]{3,8}$"
                        },
                        "payload": {
                          "type": "object"
                        },
                        "links": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "type",
                              "target"
                            ],
                            "properties": {
                              "type": {
                                "type": "string"
                              },
                              "target": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "body": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "completionEvidence": {},
              "loadedSkillRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "authoritySupplies": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "standingDelegations": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract",
          "assignment",
          "kind",
          "unable"
        ],
        "properties": {
          "contract": {
            "const": "mdlm-assignment-response@1"
          },
          "assignment": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "unable"
          },
          "unable": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "diagnostics"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "stale-scope",
                  "insufficient-declared-inputs",
                  "prohibited-input-conflict",
                  "ambiguity",
                  "execution-failure"
                ]
              },
              "diagnostics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "diagnostics": []
}
