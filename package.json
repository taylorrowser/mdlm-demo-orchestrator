{
  "name": "mdlm-demo-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mdlm-demo-runner": "bin/mdlm-demo-runner.mjs"
  },
  "files": [
    "bin/mdlm-demo-mdlm-shim.mjs",
    "bin/mdlm-demo-runner.mjs",
    "distribution-manifest.json",
    "src/*.mjs"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "manifest": "node scripts/create-distribution-manifest.mjs",
    "prepack": "node scripts/create-distribution-manifest.mjs --check",
    "check": "node scripts/create-distribution-manifest.mjs --check && node --check bin/*.mjs && node --check src/*.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
